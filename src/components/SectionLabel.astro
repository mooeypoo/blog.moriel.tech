---
import type { CollectionEntry } from 'astro:content'
import { getSectionPath } from '../lib/sections'

interface Props {
  section: CollectionEntry<'sections'>
  /** e.g. "Episode 4" */
  label?: string
}

const { section, label } = Astro.props
---

<p class="section-label">
  <a href={getSectionPath(section)}>{section.data.title}</a>
  {label && <span class="section-label-item">{label}</span>}
</p>

<style>
  /* inline-flex so it centers in post headers and left-aligns in cards. */
  .section-label {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem 0;
    font-size: 0.8rem;
    font-weight: 600;
  }

  /* currentColor keeps the label readable both on cards and over hero images. */
  .section-label a {
    padding: 0.15rem 0.6rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
  }

  .section-label a:hover {
    text-decoration: underline;
  }

  .section-label-item {
    opacity: 0.75;
  }
</style>
