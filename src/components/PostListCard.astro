---
import { getEntry, type CollectionEntry } from 'astro:content'
import PostPreviewImage from './PostPreviewImage.astro'
import SectionLabel from './SectionLabel.astro'
import { formatPostDate, getPostDisplayImage, getPostPath, getReadingMinutes } from '../lib/content'
import { getItemLabel } from '../lib/sections'

interface Props {
  post: CollectionEntry<'posts'>
  /** On a section's own landing page the section name is redundant; only "Episode 4" is shown. */
  inSection?: boolean
}

const { post, inSection = false } = Astro.props
const section = post.data.section ? await getEntry(post.data.section) : undefined
const itemLabel = section ? getItemLabel(section, post) : undefined
---

<article class="post-card">
  <PostPreviewImage href={getPostPath(post)} image={getPostDisplayImage(post)} />
  <div class="post-content">
    {section && !inSection && <SectionLabel section={section} label={itemLabel} />}
    {inSection && itemLabel && <p class="item-label">{itemLabel}</p>}
    <h2 class="post-title">
      <a href={getPostPath(post)}>{post.data.title}</a>
    </h2>
    {post.data.date && (
      <p class="post-date">{formatPostDate(post.data.date)} · {getReadingMinutes(post)} min read</p>
    )}
    {post.data.description && (
      <p class="post-desc">{post.data.description}</p>
    )}
    <p>
      <a href={getPostPath(post)} class="read-more">Read more →</a>
    </p>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
  }

  .post-content {
    flex: 1;
    min-width: 0;
  }

  .post-card :global(.post-image-link) {
    width: 220px;
  }

  .post-card :global(.post-image) {
    width: 220px;
    height: 132px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .item-label {
    margin: 0 0 0.35rem 0;
    font-size: 0.8rem;
    font-weight: 600;
    opacity: 0.75;
  }

  .post-title {
    margin: 0 0 0.5rem 0;
    font-size: 1.5rem;
  }

  .post-title a {
    text-decoration: none;
  }

  .post-title a:hover {
    text-decoration: underline;
  }

  .post-date {
    margin: 0 0 0.75rem 0;
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .post-desc {
    margin: 0 0 1rem 0;
    line-height: 1.6;
  }

  .read-more {
    text-decoration: none;
  }

  .read-more:hover {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .post-card {
      display: block;
    }

    .post-card :global(.post-image-link) {
      width: 100%;
      margin-bottom: 0.9rem;
    }

    .post-card :global(.post-image) {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }
</style>
