---
import type { CollectionEntry } from 'astro:content'
import PostRow from './PostRow.astro'

interface Props {
  posts: CollectionEntry<'posts'>[]
  /** Year headings (h2) for date-sorted lists; titles then become h3. */
  groupByYear?: boolean
  inSection?: boolean
  headingLevel?: 2 | 3
}

const { posts, groupByYear = false, inSection = false, headingLevel = 3 } = Astro.props

const years = new Map<number, CollectionEntry<'posts'>[]>()
if (groupByYear) {
  for (const post of posts) {
    const year = post.data.date.getFullYear()
    years.set(year, [...(years.get(year) ?? []), post])
  }
}
---

{groupByYear ? (
  [...years].map(([year, yearPosts]) => (
    <section class="post-list-year">
      <h2>{year}</h2>
      <ol class="post-list">
        {yearPosts.map((post) => <li><PostRow post={post} inSection={inSection} headingLevel={3} /></li>)}
      </ol>
    </section>
  ))
) : (
  <ol class="post-list">
    {posts.map((post) => <li><PostRow post={post} inSection={inSection} headingLevel={headingLevel} /></li>)}
  </ol>
)}

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
    display: grid;
    gap: 0.5rem;
  }

  .post-list-year h2 {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0 0.75rem 0;
    font-size: 1.1rem;
    opacity: 0.85;
  }

  .post-list-year h2::after {
    content: '';
    flex: 1;
    border-top: 1px solid var(--divider);
  }
</style>
