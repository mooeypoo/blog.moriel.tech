---
import { Picture } from 'astro:assets'
import type { PostImage } from '../lib/content'

interface Props {
  href: string
  image?: PostImage
  /** The rendered widths in this layout, so phones don't download desktop-sized images. */
  sizes: string
  /** For an image above the fold, which shouldn't wait for layout to start loading. */
  eager?: boolean
}

const { href, image, sizes, eager = false } = Astro.props
const loading = eager ? 'eager' : 'lazy'

const imageSrc = typeof image === 'string' ? image : undefined
const imageMeta = typeof image === 'string' ? undefined : image
---

{image && (
  <a class="post-image-link" href={href} aria-hidden="true" tabindex="-1">
    {imageMeta ? (
      <Picture
        class="post-image"
        src={imageMeta}
        alt=""
        loading={loading}
        decoding="async"
        formats={['avif']}
        fallbackFormat="webp"
        widths={[320, 480, 640, 960, 1280].filter((width) => width <= imageMeta.width)}
        sizes={sizes}
      />
    ) : (
      <img
        class="post-image"
        src={imageSrc}
        alt=""
        loading={loading}
        decoding="async"
      />
    )}
  </a>
)}

<style>
  .post-image-link {
    display: block;
    flex-shrink: 0;
  }

  .post-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 8px;
  }
</style>