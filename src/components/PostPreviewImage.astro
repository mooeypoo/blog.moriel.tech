---
import { Picture } from 'astro:assets'
import type { PostImage } from '../lib/content'

interface Props {
  href: string
  image?: PostImage
  /** Rendered widths measured on /posts; pages with another card layout pass their own. */
  sizes?: string
}

const { href, image, sizes = '(max-width: 720px) calc(100vw - 82px), 220px' } = Astro.props

const imageSrc = typeof image === 'string' ? image : undefined
const imageMeta = typeof image === 'string' ? undefined : image
---

{image && (
  <a class="post-image-link" href={href} aria-hidden="true" tabindex="-1">
    {imageMeta ? (
      <Picture
        class="post-image"
        src={imageMeta}
        alt=""
        loading="lazy"
        decoding="async"
        formats={['avif']}
        fallbackFormat="webp"
        widths={[320, 480, 640, 960, 1280].filter((width) => width <= imageMeta.width)}
        sizes={sizes}
      />
    ) : (
      <img
        class="post-image"
        src={imageSrc}
        alt=""
        loading="lazy"
        decoding="async"
      />
    )}
  </a>
)}

<style>
  .post-image-link {
    display: block;
    flex-shrink: 0;
  }

  .post-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 8px;
  }
</style>