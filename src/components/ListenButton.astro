---
// Reads the post aloud with the browser's built-in speech (ROADMAP D14, PR 9).
// Hidden until the browser reports at least one voice, so it never shows a dead button.
---

<div class="listen" data-listen hidden>
  <button type="button" class="listen-button" data-listen-play>Listen</button>
  <button type="button" class="listen-button" data-listen-stop hidden>Stop</button>
</div>

<script>
  const READABLE = 'p, h2, h3, h4, h5, h6, li, blockquote'
  // Chrome cuts off utterances after roughly 15 seconds, so long paragraphs are spoken in pieces.
  const MAX_CHUNK_LENGTH = 220

  interface Chunk {
    element: Element
    text: string
  }

  function readableText(element: Element) {
    const clone = element.cloneNode(true) as Element
    clone.querySelectorAll('.sr-only, pre, .video-embed').forEach((node) => node.remove())
    return (clone.textContent ?? '').replace(/\s+/g, ' ').trim()
  }

  // Prefer sentence breaks, then clause punctuation, then word boundaries, and pack pieces up to the limit.
  function splitLongText(text: string) {
    if (text.length <= MAX_CHUNK_LENGTH) return [text]
    const pieces = (text.match(/[^.!?]+[.!?]+["'”’)\]]*|[^.!?]+$/g) ?? [text])
      .flatMap((piece) => (piece.length <= MAX_CHUNK_LENGTH ? [piece] : piece.split(/(?<=[,;:–—])\s+/)))
      .flatMap((piece) => (piece.length <= MAX_CHUNK_LENGTH ? [piece] : piece.split(/\s+/)))
      .map((piece) => piece.trim())
      .filter(Boolean)

    const parts: string[] = []
    for (const piece of pieces) {
      const last = parts.at(-1)
      if (last !== undefined && last.length + 1 + piece.length <= MAX_CHUNK_LENGTH) parts[parts.length - 1] = `${last} ${piece}`
      else parts.push(piece)
    }
    return parts
  }

  function collectChunks(title: Element, article: Element): Chunk[] {
    const chunks: Chunk[] = [{ element: title, text: readableText(title) }]
    for (const element of article.querySelectorAll(READABLE)) {
      // Read nested blocks (a paragraph inside a list item) once, through the outer one.
      if (element.parentElement?.closest(READABLE) || element.closest('pre, .video-embed')) continue
      for (const text of splitLongText(readableText(element))) chunks.push({ element, text })
    }
    return chunks.filter((chunk) => chunk.text)
  }

  function setUp() {
    const container = document.querySelector<HTMLElement>('[data-listen]')
    const playButton = container?.querySelector<HTMLButtonElement>('[data-listen-play]')
    const stopButton = container?.querySelector<HTMLButtonElement>('[data-listen-stop]')
    const title = document.querySelector('.post-header h1')
    const article = document.querySelector('.post-content')
    if (!container || !playButton || !stopButton || !title || !article) return

    const synth = window.speechSynthesis
    let chunks: Chunk[] = []
    let index = 0
    let state: 'idle' | 'playing' | 'paused' = 'idle'
    // Cancelling fires `end` on the old utterance in some browsers; only the newest may advance.
    let generation = 0
    let highlighted: Element | undefined

    function highlight(element: Element | undefined) {
      highlighted?.classList.remove('is-being-read')
      highlighted = element
      if (!element) return
      element.classList.add('is-being-read')
      const { top, bottom } = element.getBoundingClientRect()
      if (top < 0 || bottom > window.innerHeight) element.scrollIntoView({ block: 'center' })
    }

    function render() {
      playButton!.textContent = state === 'playing' ? 'Pause' : state === 'paused' ? 'Resume' : 'Listen'
      playButton!.setAttribute('aria-pressed', String(state === 'playing'))
      stopButton!.hidden = state === 'idle'
    }

    function speak() {
      if (index >= chunks.length) return stop()
      const current = ++generation
      const utterance = new SpeechSynthesisUtterance(chunks[index].text)
      utterance.lang = document.documentElement.lang || 'en'
      utterance.onend = () => {
        if (current !== generation || state !== 'playing') return
        index++
        speak()
      }
      utterance.onerror = (event) => {
        if (current === generation && event.error !== 'interrupted' && event.error !== 'canceled') stop()
      }
      highlight(chunks[index].element)
      synth.speak(utterance)
    }

    // Native pause/resume is unreliable on Android, so pausing cancels and resuming restarts the chunk.
    function play() {
      if (state === 'idle') {
        chunks = collectChunks(title!, article!)
        index = 0
      }
      state = 'playing'
      synth.cancel()
      speak()
      render()
    }

    function pause() {
      state = 'paused'
      generation++
      synth.cancel()
      render()
    }

    function stop() {
      state = 'idle'
      generation++
      index = 0
      synth.cancel()
      highlight(undefined)
      render()
    }

    playButton.addEventListener('click', () => (state === 'playing' ? pause() : play()))
    stopButton.addEventListener('click', stop)
    window.addEventListener('pagehide', stop)

    const reveal = () => {
      if (synth.getVoices().length > 0) container.hidden = false
    }
    reveal()
    synth.addEventListener('voiceschanged', reveal)
  }

  if ('speechSynthesis' in window) setUp()
</script>

<style>
  .listen {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .listen[hidden],
  .listen-button[hidden] {
    display: none;
  }

  .listen-button {
    padding: 0.4rem 0.9rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .listen-button:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .listen-button:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: 2px;
  }
</style>
