---
import { render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostListCard from '../../components/PostListCard.astro'
import { getSectionPath, getSectionSequence, getSections } from '../../lib/sections'
import { SITE_URL } from '../../lib/seo'
import { getCardUrl } from '../../lib/social-cards'

export async function getStaticPaths() {
  const sections = await getSections()
  return sections.map((section) => ({ params: { section: section.id }, props: { section } }))
}

const { section } = Astro.props
const { Content } = await render(section)
const { sequence, updates } = await getSectionSequence(section)

const path = getSectionPath(section)
const feedPath = `${path}/rss.xml`
const isExternal = (href: string) => new URL(href).hostname !== new URL(SITE_URL).hostname
---

<BaseLayout
  title={section.data.title}
  description={section.data.description}
  canonical={`${SITE_URL}${path}`}
  ogImage={getCardUrl(`sections/${section.id}`)}
>
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title={`${section.data.title} RSS`} href={`${SITE_URL}${feedPath}`} />
  </Fragment>

  <section class="section-container">
    <header class="section-header">
      <h1>{section.data.title}</h1>
      <p class="section-description">{section.data.description}</p>
      {section.data.links.length > 0 && (
        <ul class="section-links">
          {section.data.links.map((link) => (
            <li>
              {isExternal(link.href) ? (
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="external-link">
                  {link.label}<span class="sr-only"> (opens in a new tab)</span>
                </a>
              ) : (
                <a href={link.href}>{link.label}</a>
              )}
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="section-intro">
      <Content />
    </div>

    {sequence.length === 0 && updates.length === 0 && (
      <p class="coming-soon">
        Coming soon. <a href={feedPath}>Follow this section's RSS feed</a> to get new posts as they're published.
      </p>
    )}

    {sequence.length > 0 && (
      <div class="posts-grid">
        {sequence.map((post) => <PostListCard post={post} inSection />)}
      </div>
    )}

    {updates.length > 0 && (
      <>
        <h2>Updates</h2>
        <div class="posts-grid">
          {updates.map((post) => <PostListCard post={post} inSection />)}
        </div>
      </>
    )}

    {sequence.length + updates.length > 0 && (
      <p class="section-feed"><a href={feedPath}>RSS feed for {section.data.title}</a></p>
    )}
  </section>
</BaseLayout>

<style>
  .section-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .section-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .section-description {
    font-size: 1.15rem;
    opacity: 0.9;
    margin: 0 auto 1.5rem;
    max-width: 600px;
  }

  .section-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .section-links a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border: 1px solid var(--primary);
    border-radius: 999px;
    color: var(--primary);
    text-decoration: none;
  }

  .section-links a:hover {
    background: var(--primary);
    color: var(--bg);
  }

  .section-intro {
    max-width: 85ch;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }

  .posts-grid {
    display: grid;
    gap: 2rem;
    margin: 2rem 0;
  }

  .coming-soon {
    text-align: center;
    padding: 2rem;
    border: 1px dashed var(--outline);
    border-radius: 8px;
  }

  .section-feed {
    margin-top: 3rem;
    text-align: center;
    font-size: 0.9rem;
  }
</style>
