---
import { getCardUrl } from '../../lib/social-cards'
import BaseLayout from '../../layouts/BaseLayout.astro'
import BrowseLinks from '../../components/BrowseLinks.astro'
import PostList from '../../components/PostList.astro'
import { getPublishedPosts } from '../../lib/content'
import { SITE_URL } from '../../lib/seo'

// One page, grouped by year: a list this compact stays quick to scan well past a hundred posts.
const posts = await getPublishedPosts()

const canonical = `${SITE_URL}/posts`
const title = 'All Posts'
const description = 'Browse all blog posts on Moriel\'s Blog about human-centered software development, experiences, thoughts, and learnings.'
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={getCardUrl('posts')}>
  <section class="posts-container">
    <header class="posts-header">
      <h1>All posts</h1>
      <p class="posts-count">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'} · <a href="/rss.xml">RSS feed</a>
      </p>
    </header>

    <BrowseLinks posts={posts} current="/posts" />

    {posts.length > 0 ? <PostList posts={posts} groupByYear /> : <p>No posts yet.</p>}
  </section>
</BaseLayout>

<style>
  .posts-container {
    max-width: 860px;
    margin: 0 auto;
  }

  .posts-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }

  .posts-header h1 {
    margin: 0;
  }

  .posts-count {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.8;
  }
</style>
