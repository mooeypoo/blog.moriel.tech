---
import { Picture } from 'astro:assets'
import { getCollection, getEntry, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Comments from '../../components/Comments.vue'
import ListenPlayer from '../../components/ListenPlayer.astro'
import SectionLabel from '../../components/SectionLabel.astro'
import { formatPostDate, getPostPath, getPostSlug, getPostSocialImage, getReadingMinutes, getWordCount, normalizeImageUrl } from '../../lib/content'
import { getItemLabel, getPostSectionContext, getSectionPath } from '../../lib/sections'
import { generateBlogPostingSchema, SITE_URL } from '../../lib/seo'
import { getVideoTitle } from '../../lib/videos'
import {
  findStandaloneVideoIds,
  getVideoEmbedUrl,
  getVideoThumbnailPath,
  getVideoWatchUrl,
  renderVideoEmbed,
  YOUTUBE_CHANNEL_URL,
} from '../../lib/youtube.mjs'

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.draft !== true)
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { id: post.id },
  }))
}

interface Props {
  id: string
}

const { id } = Astro.props
const post = await getEntry('posts', id)

if (!post) {
  throw new Error(`Could not find post entry for id: ${id}`)
}

const { Content } = await render(post)

const canonical = `${SITE_URL}/posts/${getPostSlug(post)}`
const title = post.data.title
const description = post.data.description
const author = 'Moriel Schottlender'
const publishedTime = post.data.date?.toISOString()
const socialImage = await getPostSocialImage(post)
const sectionContext = await getPostSectionContext(post)
// Neighbors are labeled by their number ("Episode 3") when they have one.
const sectionNav = sectionContext && (sectionContext.previous || sectionContext.next)
  ? (() => {
      const { section, previous, next } = sectionContext
      const noun = section.data.itemLabel.toLowerCase()
      return {
        sectionTitle: section.data.title,
        previous: previous && { post: previous, label: getItemLabel(section, previous) ?? `Previous ${noun}` },
        next: next && { post: next, label: getItemLabel(section, next) ?? `Next ${noun}` },
      }
    })()
  : undefined
const heroImage = post.data.image
// The hero spans the viewport, so offer widths up to large screens, but never upscale.
const heroWidths = typeof heroImage === 'object'
  ? [640, 960, 1280, 1920, 2560].filter((width) => width < heroImage.width).concat(heroImage.width)
  : []
const displayImageAlt = `${title} social preview image`
const video = post.data.video
const videoTitle = video ? await getVideoTitle(video) : undefined
// A bare URL for the same video in the body places it there instead (ROADMAP D15).
const showTopVideo = Boolean(video && post.data.videoEmbed && !findStandaloneVideoIds(post.body ?? '').includes(video))

const jsonLd = generateBlogPostingSchema({
  title,
  description,
  url: canonical,
  datePublished: post.data.date || new Date(),
  image: socialImage?.src,
  tags: post.data.tags,
  video: video && {
    name: videoTitle!,
    thumbnailUrl: `${SITE_URL}${getVideoThumbnailPath(video)}`,
    embedUrl: getVideoEmbedUrl(video),
    url: getVideoWatchUrl(video),
  },
})

---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={socialImage?.src}
  ogType="article"
  twitterCard="summary_large_image"
  ogImageAlt={displayImageAlt}
  ogImageWidth={socialImage?.width}
  ogImageHeight={socialImage?.height}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={publishedTime} />
    {post.data.tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <article class="post-detail">
    <header class:list={['post-header', { 'post-header--hero': Boolean(heroImage) }]}>
      {typeof heroImage === 'object' && (
        <Picture
          class="post-hero-image"
          src={heroImage}
          alt=""
          formats={['avif']}
          fallbackFormat="webp"
          widths={heroWidths}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
      )}
      {typeof heroImage === 'string' && (
        <img class="post-hero-image" src={normalizeImageUrl(heroImage)} alt="" fetchpriority="high" />
      )}
      <div class="post-header-content">
        {sectionContext && <SectionLabel section={sectionContext.section} label={sectionContext.label} />}
        <h1>{title}</h1>
        <p class="post-date">{formatPostDate(post.data.date)} · {getReadingMinutes(post)} min read</p>
        {post.data.description && <p class="post-description">{post.data.description}</p>}
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((tag: string) => (
              <a href={`/tags/${encodeURIComponent(tag)}`} class="tag">#{tag}</a>
            ))}
          </div>
        )}
        {video && (
          <div class="post-video-links">
            <a href={getVideoWatchUrl(video)} target="_blank" rel="noopener noreferrer" class="external-link">
              Watch on YouTube<span class="sr-only"> (opens in a new tab)</span>
            </a>
            <a href={`${YOUTUBE_CHANNEL_URL}?sub_confirmation=1`} target="_blank" rel="noopener noreferrer" class="external-link">
              Subscribe<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        )}
      </div>
    </header>

    {post.data.listen && <ListenPlayer slug={getPostSlug(post)} words={getWordCount(post)} />}

    <div class="post-content blog-prose">
      {showTopVideo && <Fragment set:html={renderVideoEmbed(video!, { title: videoTitle })} />}
      <Content />
    </div>

    {sectionNav && (
      <nav class="section-nav" aria-label={`More from ${sectionNav.sectionTitle}`}>
        {sectionNav.previous ? (
          <a class="section-nav-link" href={getPostPath(sectionNav.previous.post)}>
            <span class="section-nav-direction">← {sectionNav.previous.label}</span>
            <span class="section-nav-title">{sectionNav.previous.post.data.title}</span>
          </a>
        ) : <span />}
        {sectionNav.next && (
          <a class="section-nav-link section-nav-next" href={getPostPath(sectionNav.next.post)}>
            <span class="section-nav-direction">{sectionNav.next.label} →</span>
            <span class="section-nav-title">{sectionNav.next.post.data.title}</span>
          </a>
        )}
      </nav>
    )}

    <footer class="post-footer">
      <a href="/posts">← Back to all posts</a>
      {sectionContext && (
        <a href={getSectionPath(sectionContext.section)}>All of {sectionContext.section.data.title} →</a>
      )}
    </footer>

    <Comments client:load term={post.data.commentsId ?? getPostSlug(post)} />
  </article>
</BaseLayout>

<script>
  import { getVideoEmbedUrl } from '../../lib/youtube.mjs'

  // Swap a video thumbnail for the player on click. Modified clicks keep normal link behavior.
  document.addEventListener('click', (event) => {
    const facade = (event.target as Element | null)?.closest<HTMLAnchorElement>('.video-facade')
    if (!facade || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return
    event.preventDefault()

    const iframe = document.createElement('iframe')
    iframe.src = `${getVideoEmbedUrl(facade.dataset.videoId!)}?autoplay=1`
    iframe.title = facade.dataset.videoTitle ?? 'YouTube video'
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'
    iframe.allowFullscreen = true
    iframe.referrerPolicy = 'strict-origin-when-cross-origin'
    facade.replaceWith(iframe)
  })
</script>

<style>
  .post-detail {
    max-width: 800px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .post-header--hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 0;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    min-height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .post-header-content {
    width: 100%;
  }

  .post-header--hero .post-header-content {
    max-width: 720px;
    padding: clamp(1rem, 3vw, 1.5rem);
    border-radius: 10px;
    background: rgba(10, 10, 10, 0.68);
    backdrop-filter: blur(2px);
    color: #fff;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.28);
  }

  .post-header h1 {
    margin: 0 0 0.5rem 0;
    font-size: 2rem;
  }

  .post-date {
    margin: 0.5rem 0;
    opacity: 0.7;
    font-size: 0.95rem;
  }

  .post-description {
    margin: 1rem 0;
    font-size: 1.1rem;
    opacity: 0.9;
  }

  .post-video-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .post-video-links a {
    padding: 0.4rem 0.9rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    color: inherit;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .post-video-links a:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .post-tags {
    margin-top: 1.5rem;
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .tag {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--primary);
    border-radius: 4px;
    font-size: 0.875rem;
    text-decoration: none;
    transition: all 0.2s;
  }

  .tag:hover {
    background: var(--primary);
    color: #000;
  }

  .post-header--hero .tag {
    border-color: rgba(255, 255, 255, 0.8);
    color: #fff;
    background: rgba(0, 0, 0, 0.2);
  }

  .post-header--hero .tag:hover {
    background: #fff;
    color: #111;
    border-color: #fff;
  }

  .post-content {
    margin: 3rem auto;
  }

  .section-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
  }

  .section-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--outline);
    border-radius: 8px;
    text-decoration: none;
  }

  .section-nav-link:hover {
    border-color: var(--primary);
  }

  .section-nav-next {
    text-align: right;
  }

  .section-nav-direction {
    font-size: 0.85rem;
    opacity: 0.75;
  }

  .section-nav-title {
    font-weight: 600;
  }

  .post-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .post-footer a {
    text-decoration: none;
  }

  .post-footer a:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .section-nav {
      grid-template-columns: 1fr;
    }

    .post-header--hero {
      min-height: 280px;
    }

    .post-header--hero .post-header-content {
      padding: 1rem;
    }
  }
</style>

<style is:global>
  main.page-content {
    padding-top: 0;
  }

  /* The element being read aloud by the Listen player. */
  .is-being-read {
    border-radius: 4px;
    background: color-mix(in srgb, var(--primary) 18%, transparent);
    box-shadow: 0 0 0 0.35rem color-mix(in srgb, var(--primary) 18%, transparent);
  }

  .post-header--hero .post-hero-image {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-prose {
    font-family: var(--font-roboto);
    line-height: 1.7;
    max-width: 85ch;
  }

  .blog-prose h1,
  .blog-prose h2,
  .blog-prose h3,
  .blog-prose h4,
  .blog-prose h5,
  .blog-prose h6 {
    font-family: var(--font-merriweather);
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .blog-prose h1 {
    font-size: 2rem;
    font-weight: 700;
  }

  .blog-prose h2 {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .blog-prose h3 {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .blog-prose p {
    margin-bottom: 1em;
  }

  .blog-prose ul,
  .blog-prose ol {
    margin-left: 2em;
    margin-bottom: 1em;
  }

  .blog-prose li {
    margin-bottom: 0.5em;
  }

  .blog-prose a {
    color: var(--primary);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: opacity 0.2s;
  }

  .blog-prose a:hover {
    opacity: 0.8;
  }

  .blog-prose code {
    font-family: var(--font-inconsolata);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.92em;
    background: rgba(255, 255, 255, 0.1);
    color: inherit;
  }

  .blog-prose pre {
    padding: 1em;
    border-radius: 6px;
    overflow-x: auto;
    margin-bottom: 0.75em;
    background: rgba(0, 0, 0, 0.3);
  }

  .blog-prose pre code {
    padding: 0;
    background: transparent;
    color: inherit;
    font-size: inherit;
  }

  .blog-prose img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2em auto;
    padding: 1.5em;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
  }

  .blog-prose .video-embed {
    margin: 2rem 0;
  }

  .blog-prose .video-facade,
  .blog-prose .video-embed iframe {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }

  /* Undo the framed style post images get. */
  .blog-prose .video-facade img {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    object-fit: cover;
  }

  .blog-prose .video-play {
    position: absolute;
    inset: 0;
    width: 68px;
    height: 48px;
    margin: auto;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.75);
    transition: background 0.2s;
  }

  .blog-prose .video-play::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-40%, -50%);
    border-style: solid;
    border-width: 10px 0 10px 18px;
    border-color: transparent transparent transparent #fff;
  }

  .blog-prose .video-facade:hover .video-play,
  .blog-prose .video-facade:focus-visible .video-play {
    background: #f00;
  }

  .blog-prose .video-facade:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: 3px;
  }

  .blog-prose iframe {
    display: block;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
  }

  .blog-prose p > img + em {
    display: block;
    text-align: center;
    margin-top: -1.5em;
    margin-bottom: 1em;
    font-size: 0.8em;
    font-style: italic;
    opacity: 0.8;
  }

  .blog-prose strong {
    font-weight: 600;
  }

  .blog-prose em {
    font-style: italic;
  }

  .blog-prose blockquote {
    margin: 1.5em 0;
    padding-left: 1rem;
    border-left: 3px solid var(--primary);
    opacity: 0.9;
  }
</style>
