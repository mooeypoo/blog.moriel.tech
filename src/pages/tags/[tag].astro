---
import { getCardUrl, tagCardPath } from '../../lib/social-cards'
import BaseLayout from '../../layouts/BaseLayout.astro'
import BrowseLinks from '../../components/BrowseLinks.astro'
import PostList from '../../components/PostList.astro'
import { filterEntriesByTag, getPublishedPosts, getUniqueTags } from '../../lib/content'
import { SITE_URL } from '../../lib/seo'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  return getUniqueTags(posts).map((tag) => ({ params: { tag }, props: { tag, posts } }))
}

interface Props {
  tag: string
  posts: Awaited<ReturnType<typeof getPublishedPosts>>
}

const { tag, posts } = Astro.props
const filteredPosts = filterEntriesByTag(posts, tag)

const canonical = `${SITE_URL}/tags/${encodeURIComponent(tag)}`
const title = `Posts tagged with "${tag}"`
const description = `All posts tagged with ${tag} on Moriel's Blog.`
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={getCardUrl(tagCardPath(tag))}>
  <section class="tag-posts-container">
    <header class="tag-header">
      <h1>Posts tagged <em>#{tag}</em></h1>
      <p class="tag-count">{filteredPosts.length} {filteredPosts.length === 1 ? 'post' : 'posts'}</p>
    </header>

    <BrowseLinks posts={posts} current={`/tags/${encodeURIComponent(tag)}`} />

    <PostList posts={filteredPosts} groupByYear />

    <p class="back-link">
      <a href="/tags">All tags</a>
    </p>
  </section>
</BaseLayout>

<style>
  .tag-posts-container {
    max-width: 860px;
    margin: 0 auto;
  }

  .tag-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }

  .tag-header h1 {
    margin: 0;
    word-break: break-word;
  }

  .tag-header em {
    color: var(--primary);
    font-style: normal;
  }

  .tag-count {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .back-link {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--divider);
  }
</style>
