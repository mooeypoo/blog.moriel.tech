---
import { getCardUrl, tagCardPath } from '../../lib/social-cards'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostListCard from '../../components/PostListCard.astro'
import { getPublishedPosts } from '../../lib/content'
import { SITE_URL } from '../../lib/seo'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  const tags = new Set<string>()

  for (const post of posts) {
    for (const tag of post.data.tags || []) {
      tags.add(tag)
    }
  }

  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: { tag, posts },
  }))
}

interface Props {
  tag: string
  posts: Awaited<ReturnType<typeof getPublishedPosts>>
}

const { tag, posts } = Astro.props
const filteredPosts = posts.filter((p: (typeof posts)[number]) => (p.data.tags || []).includes(tag))

const canonical = `${SITE_URL}/tags/${encodeURIComponent(tag)}`
const title = `Posts tagged with "${tag}"`
const description = `All posts tagged with ${tag} on Moriel's Blog.`
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={getCardUrl(tagCardPath(tag))}>
  <section class="tag-posts-container">
    <h1>Posts tagged <em>#{tag}</em></h1>

    {filteredPosts.length > 0 ? (
      <div class="posts-grid">
        {filteredPosts.map((post: (typeof filteredPosts)[number]) => (
          <PostListCard post={post} />
        ))}
      </div>
    ) : (
      <p>No posts found for this tag.</p>
    )}

    <p class="back-link">
      <a href="/tags">← Back to all tags</a>
    </p>
  </section>
</BaseLayout>

<style>
  .tag-posts-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .tag-posts-container h1 {
    word-break: break-word;
  }

  .tag-posts-container em {
    color: var(--primary);
    font-style: normal;
  }

  .posts-grid {
    display: grid;
    gap: 2rem;
    margin: 2rem 0;
  }


  .back-link {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .back-link a {
    text-decoration: none;
  }

  .back-link a:hover {
    text-decoration: underline;
  }
</style>
